{
  "manifest_version": 3,
  "name": "Hal Employment",
  "version": "1.0.2",
  "description": "Lets Hal read and fill job application forms in your tabs: ones it opens, or one you hand it. Hal never presses Submit.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Hal: fill this application"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Hand this tab's application to Hal to fill"
    }
  }
}
